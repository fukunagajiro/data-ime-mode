{
  "manifest_version": 3,
  "name": "data-ime-mode",
  "version": "1.0.0",
  "description": "data-ime-mode 属性で入力欄フォーカス時の IME オン/オフを制御します (Windows / Edge)",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["nativeMessaging"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
